{
  "id": "./",
  "name": "Bulutsuz Transfer",
  "short_name": "Bulutsuz",
  "description": "Cihazlar arasında güvenli P2P dosya aktarımı",
  "lang": "tr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#f4f6fb",
  "theme_color": "#4338ca",
  "icons": [
    { "src": "./icons/app-icon.svg", "sizes": "192x192", "type": "image/svg+xml", "purpose": "any" },
    { "src": "./icons/app-icon.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["*/*"] }]
    }
  },
  "shortcuts": [{ "name": "Dosya gönder", "short_name": "Gönder", "url": "./?action=send" }]
}
